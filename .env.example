# --- Database ---
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/trend_radar
# Для psql (миграции вручную) — без драйвера:
# PSQL_URL=postgresql://user:pass@host:5432/trend_radar

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL_SCORE=gpt-4o-mini
OPENAI_MODEL_DIGEST=gpt-4o
# OPENAI_PRICE_PER_1K_INPUT=0.00015
# OPENAI_PRICE_PER_1K_OUTPUT=0.0006

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=123456789

# --- Runtime ---
TZ=Europe/Moscow
LOG_LEVEL=INFO

# --- Schedule (cron) ---
COLLECT_CRON=0 7 * * *
DIGEST_CRON=0 10 * * 1

# Throttling
HTTP_REQUESTS_PER_DOMAIN_PER_SEC=1

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=trend-radar/0.1 by your_reddit_username

PRODUCTHUNT_TOKEN=

VK_ACCESS_TOKEN=

TG_API_ID=
TG_API_HASH=

YOUTUBE_API_KEY=
